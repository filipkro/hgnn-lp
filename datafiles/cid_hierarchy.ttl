ns2:CHEMONTID_0004105 a owl:Class ;
    rdfs:label "1,3,5-triazines" ;
    ns2:IAO_0000115 "Compounds containing a triazine ring, which is a heterocyclic ring, similar to the six-member benzene ring but with three carbons replaced by nitrogen atoms, at ring positions 1, 3, and 5." ;
