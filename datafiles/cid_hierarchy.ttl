ns2:CHEMONTID_0004113 a owl:Class ;
    rdfs:label "Methoxybenzenes" ;
    ns2:IAO_0000115 "Organic aromatic compounds containing a monocyclic benzene moiety carrying exactly or one more methoxy groups." ;
