ns2:CHEMONTID_0002358 a owl:Class ;
    rdfs:label "Triterpene saponins" ;
    ns2:IAO_0000115 "Glycosylated derivatives of triterpene sapogenins. The sapogenin moiety backbone is usually based on the oleanane, ursane, taraxastane, bauerane,  lanostane, lupeol, lupane, dammarane, cycloartane, friedelane, hopane, 9b,19-cyclo-lanostane, cycloartane, or cycloartanol skeleton." ;
    ns1:hasBroadSynonym "C30 isoprenoids (triterpenes)" ;
    ns1:hasDbXref "ASIN:B004GEAWLS" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "triterpenoid saponin" ;
    ns1:id "CHEMONTID:0002358" ;
    rdfs:comment "Triterpenoid saponins share the general properties of saponins, with the addition of an ability to form complexes with cholesterol: Bitterness, hemolytic activity, decrease surface tension (i.e., form stable foams), formation of complexes with cholesterol." ;
    rdfs:subClassOf ns2:CHEMONTID_0001580 .

