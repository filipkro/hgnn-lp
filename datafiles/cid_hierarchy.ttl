    ns1:hasRelatedSynonym "Dolichols",
        "dolichol" ;
    ns1:id "CHEMONTID:0003854" ;
    rdfs:subClassOf ns2:CHEMONTID_0001535 .

ns2:CHEMONTID_0003865 a owl:Class ;
    rdfs:label "Organic salts" ;
    ns2:IAO_0000115 "Organic compounds consisting of an assembly of cations and anions." ;
