ns2:CHEMONTID_0004120 a owl:Class ;
    rdfs:label "Lycorine-type amaryllidaceae alkaloids" ;
    ns2:IAO_0000115 "Amaryllidaceae alkaloids compounds containing the lycorine skeleton, made up of a pyrrolo[d,e]phenanthridine ring system." ;
