ns2:CHEMONTID_0003796 a owl:Class ;
    rdfs:label "(3'->5')-dinucleotides and analogues" ;
    ns2:IAO_0000115 "Cyclic compounds consisting of two ribose moieties connected by one 5',3'-phosphodiester bond to form a cycle. Each ribose unit is N-linked to a nucleic base or an analogue thereof. Synthetic derivatives are generally more elaborated molecules in which one or the two nucleobase moieties, and/or sugar residues, and/or phosphodiester linkers have been modified." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-06-09T13:11:55Z" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "cyclic nucleotide" ;
    ns1:id "CHEMONTID:0003796" ;
    rdfs:subClassOf ns2:CHEMONTID_0000289 .

ns2:CHEMONTID_0003918 a owl:Class ;
    rdfs:label "Saccharolipids" ;
    ns2:IAO_0000115 "Compounds in which fatty acids are linked directly to a sugar backbone, forming structures that are compatible with membrane bilayers. In the saccharolipids, a sugar substitutes for the glycerol backbone that is present in glycerolipids and glycerophospholipids. The most familiar saccharolipids contain an acylated glucosamine. In contrast to others glycolipids, the fatty acid is not glycosidically linked to the sugar moiety." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-07-21T13:26:02Z" ;
    ns1:hasDbXref "PMID:15722563" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "Saccharolipids",
        "lipid",
        "lipopolysaccharide" ;
    ns1:id "CHEMONTID:0003918" ;
    rdfs:subClassOf ns2:CHEMONTID_0000012 .

ns2:CHEMONTID_0003924 a owl:Class ;
    rdfs:label "Phenylalkylamines" ;
    ns2:IAO_0000115 "Organic amines where the amine group is secondary and linked on one end to a phenyl group and on the other end, to an alkyl group." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-08-07T13:19:02Z" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "phenylalkylamine" ;
    ns1:id "CHEMONTID:0003924" ;
    rdfs:subClassOf ns2:CHEMONTID_0003899 .

ns2:CHEMONTID_0004112 a owl:Class ;
    rdfs:label "Benzoyl peroxides" ;
    ns2:IAO_0000115 "Organic compounds containing two benzoyl groups O-linked to each other via a peroxide group. Their skeleton has the general formula [C6H5C(O)]2O2." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-11-14T13:39:05Z" ;
    ns1:hasBroadSynonym "Peroxides",
        "benzenes",
        "peroxides" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:id "CHEMONTID:0004112" ;
    rdfs:comment "Benzoyl peroxide is used as an acne treatment, for improving flour, for bleaching hair and teeth, for cross-linking polyester resins and many other uses." ;
    rdfs:subClassOf ns2:CHEMONTID_0002279 .

