ns2:CHEMONTID_0002875 a owl:Class ;
    rdfs:label "Tigliane and ingenane diterpenoids" ;
    ns2:IAO_0000115 "Diterpenoids containing the tigliane or ingenane carbon skeleton. The tigliane skeleton is a tetracyclic ring that consists of the 4/7/6/3 ring junction. It is derived from casbane by 6,10- and 5,14-cyclizations and is a framework of phorbol. The ingenane skeleton is derived by rearrangement of tigliane." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2013-08-01T16:38:25Z" ;
    ns1:hasDbXref "ISBN:9780412466205",
