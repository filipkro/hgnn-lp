    ns2:IAO_0000115 "Lignans with a structure based on the 9,9'-epoxylignan skeleton, which consists of a tetrahydrofuran that carries two benzyl groups at the 3- and 4-positions. Additionally they are oxygenated at the 2-position to form dibenzylbutyrolactones (oxo group) or a dibenzylbutyrolactols (hydroxyl group)." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-04-04T17:42:42Z" ;
    ns1:hasBroadSynonym "Lignans" ;
    ns1:hasDbXref "ISBN:9780412466205" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "3,4-dibenzyltetrahydrofuran lignans",
        "9,9-Epoxytetrahydrofuranoid lignans",
        "lignan" ;
    ns1:id "CHEMONTID:0003424" ;
    rdfs:subClassOf ns2:CHEMONTID_0001604 .

ns2:CHEMONTID_0003425 a owl:Class ;
    rdfs:label "Aryltetralin lignans" ;
    ns2:IAO_0000115 "Lignans with a structure based on the 1-phenyltetralin skeleton." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-04-04T18:36:17Z" ;
    ns1:hasBroadSynonym "Lignans" ;
    ns1:hasDbXref "DOI:10.5772/28471" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "1-Aryl tetralin lignans",
        "1-Aryltetralin lignans",
        "2,7'-Cyclolignans",
        "Aryltetrahydronaphthalene lignans",
        "Aryltetralone lignans",
        "lignan" ;
    ns1:id "CHEMONTID:0003425" ;
    rdfs:subClassOf ns2:CHEMONTID_0001392 .

ns2:CHEMONTID_0003426 a owl:Class ;
    rdfs:label "9,9p-dihydroxyaryltetralin lignans" ;
    ns2:IAO_0000115 "Lignans with a structure based on the 1-phenyltetralin skeleton carrying a hydroxyl group at the 9- and the 9'- position." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-04-04T18:37:23Z" ;
    ns1:hasBroadSynonym "Lignans" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "lignan" ;
    ns1:id "CHEMONTID:0003426" ;
    rdfs:subClassOf ns2:CHEMONTID_0003425 .

ns2:CHEMONTID_0003449 a owl:Class ;
    rdfs:label "N-alkylpyrrolidines" ;
    ns2:IAO_0000115 "Compounds containing a pyrrolidine moiety that is substituted at the N1-position with an alkyl group. Pyrrolidine is a five-membered saturated aliphatic heterocycle with one nitrogen atom and four carbon atoms." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-04-08T14:51:44Z" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "N-alkylpyrrolidine" ;
    ns1:id "CHEMONTID:0003449" ;
    rdfs:subClassOf ns2:CHEMONTID_0000218 .

ns2:CHEMONTID_0003454 a owl:Class ;
    rdfs:label "6-alkylaminopurines" ;
    ns2:IAO_0000115 "Compounds that contain an alkylamine group attached at the 6-position of a purine. Purine is a bicyclic aromatic compound made up of a pyrimidine ring fused to an imidazole ring." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-04-08T15:14:34Z" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "thiopurine" ;
    ns1:id "CHEMONTID:0003454" ;
    rdfs:subClassOf ns2:CHEMONTID_0002987 .

ns2:CHEMONTID_0003475 a owl:Class ;
    rdfs:label "Retro-dihydrochalcones" ;
    ns2:IAO_0000115 "A form of normal dihydrochalcones that are structurally distinguished by the lack of oxygen functionalities at the C2'- and C6'-positions." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-05-08T16:50:07Z" ;
    ns1:hasBroadSynonym "Chalcones and dihydrochalcones",
        "chalcones" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:id "CHEMONTID:0003475" ;
    rdfs:subClassOf ns2:CHEMONTID_0001630 .

ns2:CHEMONTID_0003487 a owl:Class ;
    rdfs:label "Cyclic ketones" ;
    ns2:IAO_0000115 "Organic compounds containing a ketone that is conjugated to a cyclic moiety." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-04-13T22:08:50Z" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "cyclic ketone" ;
    ns1:id "CHEMONTID:0003487" ;
    rdfs:subClassOf ns2:CHEMONTID_0000118 .

ns2:CHEMONTID_0003567 a owl:Class ;
    rdfs:label "Ergostane steroids" ;
    ns2:IAO_0000115 "Steroids with a structure based on the ergostane skeleton, which arises from the methylation of cholestane at the 24-position." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-04-28T15:58:11Z" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "24-methylcholestane steroids",
        "<new synonym>",
        "Ergosterols and C24-methyl derivatives",
        "ergostanoid" ;
    ns1:id "CHEMONTID:0003567" ;
    rdfs:subClassOf ns2:CHEMONTID_0000258 .

ns2:CHEMONTID_0003583 a owl:Class ;
    rdfs:label "Linear triquinanes" ;
    ns2:IAO_0000115 "Triquinane with a structure based on a [6.3.0.0^2,6] undecane carbon skeleton." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-04-30T13:21:30Z" ;
    ns1:hasBroadSynonym "C15 isoprenoids (sesquiterpenes)",
        "Sesquiterpenes" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "sesquiterpenoid" ;
    ns1:id "CHEMONTID:0003583" ;
    rdfs:subClassOf ns2:CHEMONTID_0002004 .

ns2:CHEMONTID_0003590 a owl:Class ;
    rdfs:label "Imidazo-[4,5-c]pyridines" ;
    ns2:IAO_0000115 "Organic heterocyclic compounds containing an imidazo-[4,5-c]pyridine ring system. Imidazo-[4,5-c]pyridine consists of an imidazole ring fused to a pyridine, so that the three ring nitrogen atoms are at the 1-, 2-, and 5-position, respectively." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-04-30T17:55:33Z" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "A pyrido[3,4-d]imidazole",
        "Pyrido-[3,4-d]-imidazoles",
        "Pyrido[3,4-d]imidazoles",
        "imidazopyridine" ;
    ns1:id "CHEMONTID:0003590" ;
    rdfs:subClassOf ns2:CHEMONTID_0000328 .

ns2:CHEMONTID_0003597 a owl:Class ;
    rdfs:label "Naphthalene sulfonic acids and derivatives" ;
    ns2:IAO_0000115 "Organic aromatic compounds that contain a naphthalene moiety that carries a sulfonic acid group (or a derivative thereof) at one or more positions. Naphthalene is a bicyclic compound that is made up of two fused benzene ring." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-05-04T15:35:53Z" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "naphthalenes",
        "sulfonic acid derivative" ;
    ns1:id "CHEMONTID:0003597" ;
    rdfs:subClassOf ns2:CHEMONTID_0000023 .

ns2:CHEMONTID_0003599 a owl:Class ;
    rdfs:label "2-naphthalene sulfonic acids and derivatives" ;
    ns2:IAO_0000115 "Organic aromatic compounds that contain a naphthalene moiety that carries a sulfonic acid group (or a derivative thereof) at the 2-position. Naphthalene is a bicyclic compound that is made up of two fused benzene ring." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-05-04T15:37:33Z" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "naphthalenes",
        "sulfonic acid derivative" ;
    ns1:id "CHEMONTID:0003599" ;
    rdfs:subClassOf ns2:CHEMONTID_0003597 .

ns2:CHEMONTID_0003630 a owl:Class ;
    rdfs:label "Organic 1,3-dipolar compounds" ;
    ns2:IAO_0000115 "Electrically neutral organic molecules carrying a positive and a negative charge in one of their major canonical descriptions. In most dipolar compounds the charges are delocalized; however the term is also applied to species where this is not the case. The term 1,3-dipolar compounds is used for those in which a significant canonical resonance form can be represented by a separation of charge over three atoms (in connection with 1,3-dipolar cycloadditions)." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-05-07T13:05:00Z" ;
    ns1:hasDbXref "ISBN:0967855098" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "dipolar compound" ;
    ns1:id "CHEMONTID:0003630" ;
    rdfs:subClassOf ns2:CHEMONTID_0000000 .

ns2:CHEMONTID_0003631 a owl:Class ;
    rdfs:label "Allyl-type 1,3-dipolar organic compounds" ;
    ns2:IAO_0000115 "Organic 1,3-dipolar compounds with the general structure  X=Y+-Z- <-> X--Y+=Z<-> X+-Y-Z-<-> X-=Y-Z+ (X, Z = C, N, or O; Y = N or O)." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-05-07T13:05:20Z" ;
    ns1:hasDbXref "ISBN:0967855098" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "dipolar compound" ;
    ns1:id "CHEMONTID:0003631" ;
    rdfs:subClassOf ns2:CHEMONTID_0003630 .

ns2:CHEMONTID_0003655 a owl:Class ;
    rdfs:label "Eremophilane, 8,9-secoeremophilane and furoeremophilane sesquiterpenoids" ;
    ns2:IAO_0000115 "Sesquiterpenoids with a structure based either on the eremophilane skeleton, its 8,9-seco derivative, or the furoeremophilane skeleton. Eremophilanes have been shown to be derived from eudesmanes by migration of the methyl group at C-10 to C-5." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-05-08T11:02:21Z" ;
    ns1:hasBroadSynonym "C15 isoprenoids (sesquiterpenes)",
        "Sesquiterpenes" ;
    ns1:hasDbXref "ISBN:9780412466205" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "sesquiterpenoid" ;
    ns1:id "CHEMONTID:0003655" ;
    rdfs:subClassOf ns2:CHEMONTID_0001550 .

ns2:CHEMONTID_0003662 a owl:Class ;
    rdfs:label "Organic phosphoric acid diamides" ;
    ns2:IAO_0000115 "Organophosphorus compounds with the general formula RNP(R2)(O)=O (R=alkyl, aryl; R2 = amine group)." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-05-09T08:56:59Z" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "Diaminophosphoric acids",
        "Organic phosphoromonoamides",
        "phosphoric acid derivative" ;
    ns1:id "CHEMONTID:0003662" ;
    rdfs:subClassOf ns2:CHEMONTID_0001204 .

ns2:CHEMONTID_0003672 a owl:Class ;
    rdfs:label "Alpha,beta-unsaturated ketones" ;
    ns2:IAO_0000115 "Ketones with the general structure R#CC(=O)R' or R=CC(=O)R', where R=organyl and R'= organyl group." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-05-09T16:50:12Z" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "alpha,beta-unsaturated ketone" ;
    ns1:id "CHEMONTID:0003672" ;
    rdfs:subClassOf ns2:CHEMONTID_0003131 .

ns2:CHEMONTID_0003686 a owl:Class ;
    rdfs:label "Furanoid lignans" ;
    ns2:IAO_0000115 "Lignans with a structure that contains either a tetrahydrofuran ring, a furan ring, or a furofuan ring system, that arises from the joining of the two phenylpropanoid units." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-05-14T11:17:44Z" ;
    ns1:hasBroadSynonym "Lignans" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "lignan" ;
    ns1:id "CHEMONTID:0003686" ;
    rdfs:subClassOf ns2:CHEMONTID_0001392 .

ns2:CHEMONTID_0003740 a owl:Class ;
    rdfs:label "1,3-substituted cyclopentyl nucleosides" ;
    ns2:IAO_0000115 "Nucleoside analogues with a structure that consists of a cyclobutane that is substituted a the 1-position with a hydroxyl group and at the 3-position with either a purine or pyrimidine base." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-05-21T18:03:56Z" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "nucleobase-containing molecular entity" ;
    ns1:id "CHEMONTID:0003740" ;
    rdfs:subClassOf ns2:CHEMONTID_0003738 .

ns2:CHEMONTID_0003759 a owl:Class ;
    rdfs:label "Macroline alkaloids" ;
    ns2:IAO_0000115 "Alkaloids with a structure that is based on the tetracyclic macroline skeleton. The macroline skeleton arises by scission of the C-21 to N-4 bond  of the akuammilan skeleton, and mostly occurs in bisindole alkaloids." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-05-29T12:11:09Z" ;
    ns1:hasDbXref "ISBN:978-1-4200-7769-8" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "indole alkaloid" ;
    ns1:id "CHEMONTID:0003759" ;
    rdfs:subClassOf ns2:CHEMONTID_0000279 .

ns2:CHEMONTID_0003792 a owl:Class ;
    rdfs:label "(3'->5')-cyclic dinucleotides and analogues" ;
    ns2:IAO_0000115 "Cyclic compounds consisting of two ribose moieties connected by two 5',3'-phosphodiester bonds to form a cycle. Each ribose unit is N-linked to a nucleic base or an analogue thereof. Some natural (3'->5')-cyclic dinucleotides include c-di-AMP. Synthetic derivatives are generally more elaborated molecules in which one or the two nucleobase moieties, and/or sugar residues, and/or phosphodiester linkers have been modified." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-06-09T12:14:44Z" ;
    ns1:hasDbXref "PMID:23767818" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "cyclic nucleotide" ;
    ns1:id "CHEMONTID:0003792" ;
    rdfs:subClassOf ns2:CHEMONTID_0003796 .

ns2:CHEMONTID_0003805 a owl:Class ;
    rdfs:label "Indolonaphthyridine alkaloids" ;
    ns2:IAO_0000115 "A numerous and relatively straightforward subgroup of the b-carbolines, e.g. Canthin-6-one, in which an additional C3 unit is attached between C-1 and the indole nitrogen to form an additional ring. The group includes a few dimeric examples, such as Haplophytine." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-06-25T13:39:18Z" ;
    ns1:hasBroadSynonym "alkaloid" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "Canthinones",
        "Indolo[3,2-1de][1,5]naphthyridines",
        "organic heterotetracyclic compound" ;
    ns1:id "CHEMONTID:0003805" ;
    rdfs:subClassOf ns2:CHEMONTID_0000279 .

ns2:CHEMONTID_0003815 a owl:Class ;
    rdfs:label "Triradylcglycerols" ;
    ns2:IAO_0000115 "Glycerolipids that carry exactly three acyl chains attached to the glycerol moiety." ;
    ns1:created_by "yandj" ;
    ns1:creation_date "2014-06-25T23:33:47Z" ;
    ns1:hasOBONamespace "chemont" ;
    ns1:hasRelatedSynonym "Triradylglycerols",
        "glycerolipid" ;
    ns1:id "CHEMONTID:0003815" ;
    rdfs:subClassOf ns2:CHEMONTID_0000175 .

ns2:CHEMONTID_0003854 a owl:Class ;
    rdfs:label "Dolichols" ;
    ns2:IAO_0000115 "A group of long-chain mostly unsaturated organic compounds that are made up of varying numbers of isoprene units terminating in an alpha-saturated isoprenoid group, containing an alcohol functional group. The three isoprene units at the distal end  are trans-linked." ;
