###  http://purl.obolibrary.org/obo/CHEMONTID_0001787
<http://purl.obolibrary.org/obo/CHEMONTID_0001787> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0000261> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "A group of chemically related metabolites containing a 3,4-dihydro-3-methylisocoumarin moiety linked through a carboxyl group to L-beta-phenylalanine by a secondary amine bond." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "monocarboxylic acid amide" ,
                                                                                                                  "phenylalanine derivative" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "DOI:10.1021/ba-1976-0149.ch005" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "isochromanes" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#id> "CHEMONTID:0001787" ;
                                                   rdfs:comment "They are isolated originally from culture extracts of Aspergillus ochraceus, and subsequently from other Aspergillus spp. and from Penicullium viridicatum. The most important and most toxic ochratoxin found naturally in food is ochratoxin A (OTA). The only other ochratoxin found in food is ochratoxin B, which is rare and much less toxic. Other structurally related ochratoxins include ochratoxin C, alpha and beta. These have been isolated from fungal cultures, but are not normally found in foods." ;
                                                   rdfs:label "Ochratoxins and related substances" .

