###  http://purl.obolibrary.org/obo/CHEMONTID_0003758
<http://purl.obolibrary.org/obo/CHEMONTID_0003758> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0000279> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "Alkaloids with a structure that is based on the tetracyclic gelsemium skeleton. These alkaloids contain an oxindole function and a cage-like, hydroaromatic residue which is believed to arise from an intermediate related to anhydrovobasinediol by formation of a 6,20 bond and rearrangement to an oxindole. The major alkaloids in this group are related to Gelsemine; however, a smaller group, characterized by Gelsedine, lack the 6,20 bond, and have also lost C-21." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#created_by> "yandj" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#creation_date> "2014-05-29T11:50:16Z" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-1-4200-7769-8" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "indole alkaloid" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#id> "CHEMONTID:0003758" ;
                                                   rdfs:label "Gelsemium alkaloids" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/CHEMONTID_0003758> ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/IAO_0000115> ;
   owl:annotatedTarget "Alkaloids with a structure that is based on the tetracyclic gelsemium skeleton. These alkaloids contain an oxindole function and a cage-like, hydroaromatic residue which is believed to arise from an intermediate related to anhydrovobasinediol by formation of a 6,20 bond and rearrangement to an oxindole. The major alkaloids in this group are related to Gelsemine; however, a smaller group, characterized by Gelsedine, lack the 6,20 bond, and have also lost C-21." ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-1-4200-7769-8"
 ] .

