   owl:annotatedTarget "Aromatic heterocyclic compounds containing a pyrazole ring and a pyrazine ring fused to one another without sharing a nitrogen atom." ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10989833" ,
                                                            "PMID:24618512"
 ] .

