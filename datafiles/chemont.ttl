###  http://purl.obolibrary.org/obo/CHEMONTID_0004370
<http://purl.obolibrary.org/obo/CHEMONTID_0004370> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0000002> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "Aromatic heterocyclic compounds containing a pyrazole ring and a pyrazine ring fused to one another without sharing a nitrogen atom." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#created_by> "yandj" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#creation_date> "2015-05-12T14:11:31Z" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "organonitrogen heterocyclic compound" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10989833" ,
                                                                                                            "PMID:24618512" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#id> "CHEMONTID:0004370" ;
                                                   rdfs:comment "Pyrazolo[3,4-b]pyrazine ring system is an interesting class of heterocycles of great medical importance. It has been reported that some of its derivatives are used as inhibitors of protein kinases,blood platelet aggregation, bone metabolism improvers, anti-inflammatories, antifungal, antibacterial, antiparasitic, and anticancer agents. On the other hand, pyrazolo[3,4-b]pyrazines are also used as fluorescent and disperse dyes in dye chemistry[PMID24618512]." ;
                                                   rdfs:label "Pyrazolo[3,4-b]pyrazines" .

