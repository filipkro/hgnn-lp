   owl:annotatedTarget "C20 isoprenoids (diterpenes)" ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "LIPIDMAPS:PR0104" ;
   <http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/ChemOnt#LIPIDMAPS_TERM>
 ] .

