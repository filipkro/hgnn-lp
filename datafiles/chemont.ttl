###  http://purl.obolibrary.org/obo/CHEMONTID_0001768
<http://purl.obolibrary.org/obo/CHEMONTID_0001768> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0001538> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "Diterpene lactones with a structure based either on the gingkolide or the bilobalide skeleton. The ginkgolide skeleton is a very rigid structure consisting of hexacyclic C20 trilactone. The cis-fused F/A/D/C ring junction forms an empty semi-ball hole, the D ring contains a cage form tetrahydrofuran ring which occupies the center of the empty hole, and the oxygen atoms of the D,C and F ring and 10-hydroxyl group consist of an analogous crown ether structure." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN-13:978-1-4398-6077-9" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> "Bilobalides" ,
                                                                                                                   "Ginkgolides" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Ginkgolides and Bilobalides" ,
                                                                                                                    "diterpene lactone" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#id> "CHEMONTID:0001768" ;
                                                   rdfs:label "Ginkgolides and bilobalides" .

