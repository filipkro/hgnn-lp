###  http://purl.obolibrary.org/obo/CHEMONTID_0002518
<http://purl.obolibrary.org/obo/CHEMONTID_0002518> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0001334> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "Waxy derivatives of fatty acids (usually C32 or C34), containing a terminal carboxylic acid combined with a 2-propanol unit at the C-2 position to form a methyl- substituted alpha,beta-unsaturated-gamma-lactone. One of their interesting structural features is a single, adjacent, or nonadjacent tetrahydrofuran (THF) or tetrahydropyran (THP) system with one or two flanking hydroxyl group(s) at the center of a long hydrocarbon chain." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "Acetogenins" ,
                                                                                                                  "polyketide" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Annonaceae acetogenins" ;
