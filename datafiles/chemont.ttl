###  http://purl.obolibrary.org/obo/CHEMONTID_0003018
<http://purl.obolibrary.org/obo/CHEMONTID_0003018> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0000279> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "Alkaloids with a structure that contains the isoaporphine skeleton. Isoaporphine is an isomer of aporphine, with the difference that the N atom of the quinoline moiety is at the 1-position instead of the 6-position. This compounds also include oxoisoaporphines, which bear an oxo group at the 7-position. Oxoisoaporphines are believed to arise from aporphines via a spirodienone rearrangement." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#created_by> "yandj" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#creation_date> "2013-11-26T17:34:10Z" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "alkaloid" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:978-1-4200-7769-8" ,
                                                                                                            "ISBN:9780080865775" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#id> "CHEMONTID:0003018" ;
                                                   rdfs:label "Isoaporphines" .

