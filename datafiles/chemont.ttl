###  http://purl.obolibrary.org/obo/CHEMONTID_0003397
<http://purl.obolibrary.org/obo/CHEMONTID_0003397> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0001551> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "Diterpenoids with a structure characterized by a sphenolobane skeleton. They possess a trans-fused hydroazulenoid skeleton as a common structural motif, but differ in configuration at C(9), where a prenyl group is attached. Sphenolobane is also considered an 'extended' daucane skeleton, with a carbon side chain appended onto the cyclopentane ring." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#created_by> "yandj" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#creation_date> "2014-04-03T16:55:56Z" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "Diterpenes" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:9780412466205" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Prenyldaucane diterpenoids" ,
                                                                                                                    "Sphenolobane diterpenoids" ,
                                                                                                                    "diterpenoid" ,
                                                                                                                    "tormesane diterpenes" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#id> "CHEMONTID:0003397" ;
                                                   rdfs:label "Sphenolobane diterpenoids" .

