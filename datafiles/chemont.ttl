###  http://purl.obolibrary.org/obo/CHEMONTID_0001547
<http://purl.obolibrary.org/obo/CHEMONTID_0001547> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0001534> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "Quinone lipids containing a methylated naphthoquinone ring structure, and vary in the aliphatic side chain attached at the 3-position." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:wiki/Vitamin_K" ,
                                                                                                            "Wikipedia:wiki/Vitamin_K2" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Vitamin K" ,
                                                                                                                    "vitamin K" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#id> "CHEMONTID:0001547" ;
                                                   rdfs:comment "K vitamins play an essential role as cofactor for the enzyme gamma-glutamyl carboxylase, which is involved in carboxylation of the vitamin K-dependent proteins [i.e., conversion of peptide-bound glutamic acid (Glu) to gamma-carboxy glutamic acid (Gla)]. Without vitamin K, blood coagulation is seriously impaired, and uncontrolled bleeding occurs. Low levels of vitamin K also weaken bones and promote calcification of arteries and other soft tissues (Wikipedia)." ;
                                                   rdfs:label "Vitamin K compounds" .

