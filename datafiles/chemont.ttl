###  http://purl.obolibrary.org/obo/CHEMONTID_0001575
<http://purl.obolibrary.org/obo/CHEMONTID_0001575> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0001606> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "Ester derivatives of retinoic acid. These are obtained by formal condensation of the hydroxy group of retinol with the carboxy group of any carboxylic acid." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "Retinoids" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Retinoids" ,
                                                                                                                    "retinyl ester" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#id> "CHEMONTID:0001575" ;
                                                   rdfs:comment """In humans, Diacylglycerol O-acyltransferase 1 (DGAT1) and Diacylglycerol O-acyltransferase 1 (DGAT2) also catalyze the reaction: Acyl-CoA + retinol = CoA + retinyl ester. They function as the major acyl-CoA retinol acyltransferase (ARAT) in the skin, where it acts to maintain retinoid homeostasis and prevent retinoid toxicity leading to skin and hair disorders. (UniProt)
In humans, Acyl-CoA wax alcohol acyltransferase 2 (AWAT2) may also have 2-acylglycerol O-acyltransferase (MGAT) and acyl-CoA:retinol acyltransferase (ARAT) activities, to catalyze the synthesis of diacylglycerols and retinyl esters; however this activity is unclear in vivo. (UniProt)""" ;
                                                   rdfs:label "Retinoid esters" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/CHEMONTID_0001575> ;
   owl:annotatedProperty <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> ;
   owl:annotatedTarget "Retinoids" ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MESH:D02.455.326.271.665.202.495" ;
   <http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/ChemOnt#MeSH_TERM>
 ] .

