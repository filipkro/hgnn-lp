[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/CHEMONTID_0002783> ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/IAO_0000115> ;
   owl:annotatedTarget "Alkaloids with a structure based on either the akuammilan skeleton. The ring system in this group is formed from a precursor of the corynantheine type by bond formation between C-16 and C-7. Variations in this subgroup include, among others, alkaloids derived by C-3 to N-4 bond fission, as well as alkaloids in which the N-4 to C-5 bond in the Akuammiline skeleton has been severed." ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:9780412466205"
 ] .

