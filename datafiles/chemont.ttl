                                                                                                            "PMID:672461" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Rhamnofolane and daphnane diterpenoids" ,
                                                                                                                    "diterpenoid" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#id> "CHEMONTID:0003494" ;
                                                   rdfs:label "Rhamnofolane and daphnane diterpenoids" .

