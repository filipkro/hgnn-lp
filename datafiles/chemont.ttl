###  http://purl.obolibrary.org/obo/CHEMONTID_0004022
<http://purl.obolibrary.org/obo/CHEMONTID_0004022> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0003025> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "Oligo- and polypeptides consisting of any C-terminal alpha peptide having a L-gamma-glutamyl residue attached at the N alpha-position." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#created_by> "yandj" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#creation_date> "2014-10-14T13:21:34Z" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "peptide" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#id> "CHEMONTID:0004022" ;
                                                   rdfs:comment "In humans, Gamma-glutamyltransferase 5 (GGT5) and Gamma-glutamyltranspeptidase 1 (GGT1) catalyzes the reaction: A (5-L-glutamyl)-peptide + an amino acid = a peptide + a 5-L-glutamyl amino acid." ;
                                                   rdfs:label "(5L-glutamyl)-alpha-peptides" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/CHEMONTID_0004022> ;
