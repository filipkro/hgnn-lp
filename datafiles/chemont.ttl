###  http://purl.obolibrary.org/obo/CHEMONTID_0001781
<http://purl.obolibrary.org/obo/CHEMONTID_0001781> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0001550> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "Sesquiterpenoids with a structure based on an aromadendrane (a cyclopropa[e]azulene derivative) skeleton. Some aromadendrane sesquiterpenoids are found in essential oils. Certain aromadendrane Sesquiterpenoids from the Leaves of Xylopia brasiliensis were found to possess antifungal activities." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "Sesquiterpenes" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:9780412466205" ;
