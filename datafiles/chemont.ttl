###  http://purl.obolibrary.org/obo/CHEMONTID_0002119
<http://purl.obolibrary.org/obo/CHEMONTID_0002119> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0001283> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "A group of compounds chemically degraded from triterpenes. According to their basic skeleton, quassinoids are categorized into five distinct groups, C-18, C-19, C-20, C-22 and C-25 types. The C-20 quassinoids can be further classified into two types, tetracyclic and the pentacyclic. The tetracyclic variety does not have oxygenation at C-20, while the pentacyclic quassinoids possess additional oxygenation at C-20 that allows for the formation of an additional ring." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> "C30 isoprenoids (triterpenes)" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15638734" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "quassinoid" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#id> "CHEMONTID:0002119" ;
                                                   rdfs:label "Quassinoids" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/CHEMONTID_0002119> ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/IAO_0000115> ;
   owl:annotatedTarget "A group of compounds chemically degraded from triterpenes. According to their basic skeleton, quassinoids are categorized into five distinct groups, C-18, C-19, C-20, C-22 and C-25 types. The C-20 quassinoids can be further classified into two types, tetracyclic and the pentacyclic. The tetracyclic variety does not have oxygenation at C-20, while the pentacyclic quassinoids possess additional oxygenation at C-20 that allows for the formation of an additional ring." ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15638734"
 ] .

