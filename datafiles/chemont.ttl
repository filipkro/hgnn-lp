###  http://purl.obolibrary.org/obo/CHEMONTID_0004024
<http://purl.obolibrary.org/obo/CHEMONTID_0004024> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0001523> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "Compounds containing bond between a carbon atom and a lead atom." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#created_by> "yandj" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#creation_date> "2014-10-20T11:13:21Z" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "organolead compound" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#id> "CHEMONTID:0004024" ;
                                                   rdfs:comment "Organic lead is fat soluble and can be absorbed through the skin. Lead interferes with numerous physiological processes. In the haeme biosynthetic pathway, it inhibits delta-aminolevulinic acid dehydratase (also known as porphobilinogen synthase), probably through its high affinity for the zinc-binding site in the enzyme. Lead inhibits pyrimidine-5'-nucleotidase, resulting in accumulation of nucleotides, and subsequent haemolysis and anaemia. Renal manifestations of acute lead poisoning include glycosuria, aminoaciduria and phosphaturia. Exposure to lead is associated with cardiovascular effects and with changes in endocrine and immune functions. In humans, prenatal lead exposure is associated with an increased risk for minor malformations, low birth weight and reduced postnatal growth rate. The effect on postnatal growth rate is apparent only in those children with continuing postnatal lead exposure. Lead is neurotoxic." ;
                                                   rdfs:label "Organolead compounds" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/CHEMONTID_0004024> ;
   owl:annotatedProperty <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> ;
