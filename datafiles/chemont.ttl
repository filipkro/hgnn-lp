###  http://purl.obolibrary.org/obo/CHEMONTID_0002875
<http://purl.obolibrary.org/obo/CHEMONTID_0002875> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/CHEMONTID_0001551> ;
                                                   <http://purl.obolibrary.org/obo/IAO_0000115> "Diterpenoids containing the tigliane or ingenane carbon skeleton. The tigliane skeleton is a tetracyclic ring that consists of the 4/7/6/3 ring junction. It is derived from casbane by 6,10- and 5,14-cyclizations and is a framework of phorbol. The ingenane skeleton is derived by rearrangement of tigliane." ;
                                                   <http://www.geneontology.org/formats/oboInOwl#created_by> "yandj" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#creation_date> "2013-08-01T16:38:25Z" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:9780412466205" ,
                                                                                                            "PMID:672461" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> "chemont" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "Tigliane and ingenane diterpenoids" ,
                                                                                                                    "diterpenoid" ;
                                                   <http://www.geneontology.org/formats/oboInOwl#id> "CHEMONTID:0002875" ;
                                                   rdfs:label "Tigliane and ingenane diterpenoids" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.obolibrary.org/obo/CHEMONTID_0002875> ;
   owl:annotatedProperty <http://purl.obolibrary.org/obo/IAO_0000115> ;
   owl:annotatedTarget "Diterpenoids containing the tigliane or ingenane carbon skeleton. The tigliane skeleton is a tetracyclic ring that consists of the 4/7/6/3 ring junction. It is derived from casbane by 6,10- and 5,14-cyclizations and is a framework of phorbol. The ingenane skeleton is derived by rearrangement of tigliane." ;
   <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN-13:978-1-4398-6077-9" ,
                                                            "ISBN:9780412466205"
 ] .

